#!/usr/bin/env bash
# Popup picker for all windows across sessions.
# Invoked from tmux.conf via prefix+W.
set -eu

# Tab-separate target from display so session names with spaces survive `cut`.
TAB=$(printf '\t')
fmt="#{session_name}:#{window_index}${TAB}#{session_name}:#{window_index} #{window_name}"

selection=$(tmux list-windows -a -F "$fmt" | fzf --reverse --delimiter="$TAB" --with-nth=2 --prompt='window > ' || true)

target=$(printf '%s' "$selection" | cut -f1)
case "$target" in
  *:*)
    tmux switch-client -t "$target"
    tmux select-window -t "$target"
    ;;
esac
