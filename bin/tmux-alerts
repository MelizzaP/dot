#!/usr/bin/env bash
# Popup picker for windows with an alert flag (bell or @claude).
# Invoked from tmux.conf via prefix+N.
set -eu

# Tab-separate target from display so session names with spaces survive `cut`.
TAB=$(printf '\t')
fmt="#{?#{||:#{window_bell_flag},#{@claude}},#{session_name}:#{window_index}${TAB}#{session_name}:#{window_index} #{?window_bell_flag,󰂞 ,}#{@claude}#W,}"

list=$(tmux list-windows -a -F "$fmt" | grep -v '^$' || true)

selection=$(printf '%s\n' "${list:-(no alerts)}" | fzf --reverse --delimiter="$TAB" --with-nth=2 --prompt='alerts > ' || true)

target=$(printf '%s' "$selection" | cut -f1)
case "$target" in
  *:*)
    tmux switch-client -t "$target"
    tmux select-window -t "$target"
    ;;
esac
